# `pnpm setup:local` copies this to .env and replaces every change-me with generated secrets.
# Never commit .env.
APP_ORIGIN=http://localhost:4330
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# Native development reaches Docker Postgres on loopback; Compose overrides this with host `db`.
DATABASE_URL=postgres://bayline:change-me@127.0.0.1:54330/bayline
# Tests only ever read this, and refuse to run if it names the same database as DATABASE_URL.
TEST_DATABASE_URL=postgres://bayline:change-me@127.0.0.1:54330/bayline_test
LOCATION_TIMEZONE=Asia/Kathmandu
# Shared password for every synthetic account created by `pnpm db:seed`. Generated separately.
DEMO_PASSWORD=generate-demo-password
